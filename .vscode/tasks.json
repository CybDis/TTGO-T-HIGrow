{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Reset and Monitor ESP32",
      "type": "shell",
      "command": "python3",
      "args": [
        "${workspaceFolder}/reset_and_monitor.py",
        "${input:port}",
        "${input:baud}"
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "port",
      "type": "promptString",
      "description": "Serial port (leave empty for auto-detect)",
      "default": ""
    },
    {
      "id": "baud",
      "type": "promptString",
      "description": "Baud rate",
      "default": "115200"
    }
  ]
}
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP32 Reset via DTR",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/Scripts/python.exe",
            "args": ["reset_esp32.py"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "group": {
                "kind": "test"
            }
        }
    ]
}
